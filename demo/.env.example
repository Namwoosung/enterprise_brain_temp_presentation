# Copy to .env and edit. CUSTOMIZE: everything here is machine-specific.
# --- Neo4j (installed separately; the demo never contains Neo4j itself)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me
NEO4J_DATABASE=neo4j
NEO4J_HTTP_URL=http://localhost:7474     # Neo4j Browser (served by Neo4j on its HTTP port)
# --- LLM: any OpenAI-compatible server (vLLM, in-house gateway, ...)
LLM_BASE_URL=http://localhost:10000/v1
LLM_MODEL=local-llm
LLM_API_KEY=EMPTY                        # vLLM convention when no key is required
LLM_MODE=auto                            # auto | live | replay
# --- demo web
DEMO_PORT=8800
BROWSER_PROXY_PORT=8801                  # re-serves Neo4j Browser without iframe-blocking headers
